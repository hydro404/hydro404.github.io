---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { profile } from '../data/portfolio';

interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Luis Anthony Grado is a Full-Stack Software Engineer building web and mobile applications, business systems, and automation. Explore projects and technical experience.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/achievements/', label: 'Achievements' },
];
const fullTitle = title === 'Home' ? `${profile.name} — Full-Stack Software Engineer` : `${title} — ${profile.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9f5" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/manrope-latin.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/social-preview.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Luis Anthony Grado — Full-Stack Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" transition:name="site-header" transition:animate="none">
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="Luis Grado, home">luis grado<span aria-hidden="true">.</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
          <span class="menu-label">Menu</span><span class="menu-lines" aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          {nav.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}
          <a href="#contact">Let’s talk</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer id="contact" class="site-footer">
      <div class="container rail">
        <h2 class="rail-label">Let’s talk</h2>
        <div class="rail-body">
          <p class="footer-statement">Good software starts with a conversation. Reach out about an engineering role, a project idea, or a question.</p>
          <ul class="link-row">
            <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a></li>
            <li><a href={profile.calendly} target="_blank" rel="noopener noreferrer">Schedule a meeting <span aria-hidden="true">↗</span></a></li>
          </ul>
          <div class="footer-bottom">
            <p>© {new Date().getFullYear()} Luis Anthony Grado</p>
            <ul class="footer-links">
              <li><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
              <li><a href={profile.resume} download>Résumé</a></li>
              <li><a href="/achievements/">Achievements</a></li>
              <li><a href="#main">Back to top</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
