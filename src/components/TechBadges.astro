---
import { technologyIconUrl, visibleTechnologies } from '../data/technologies';

interface Props {
  technologies: readonly string[];
  class?: string;
}

const { technologies, class: className } = Astro.props;
const badges = visibleTechnologies(technologies);
---

{badges.length > 0 && (
  <ul class:list={['technology-list', className]} role="list">
    {badges.map(({ label, icons, mono }) => (
      <li class="technology-badge" data-technology={label}>
        {icons.length > 0 && (
          <span class="technology-marks" aria-hidden="true">
            {icons.map((filename) => (
              <img src={technologyIconUrl(filename)} alt="" width="16" height="16" loading="lazy" decoding="async" data-mono={mono ? '' : undefined} />
            ))}
          </span>
        )}
        <span class="technology-label">{label}</span>
      </li>
    ))}
  </ul>
)}

<style>
  .technology-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A pill, matching .badge in global.css. */
  .technology-badge {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    max-width: 100%;
    padding: 3px 10px 3px 8px;
    border-radius: 999px;
    background: var(--fill);
    color: var(--ink);
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .technology-marks {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2px;
  }

  /* Logos keep their own colours. A plain-black logo turns white in the dark theme. */
  .technology-marks img {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  .technology-marks img[data-mono] {
    filter: var(--mono-icon-filter);
  }

  .technology-label {
    overflow-wrap: anywhere;
  }
</style>
