---
import { Image } from 'astro:assets';
import type { Achievement } from '../data/achievements';

interface Props {
  item: Achievement;
}

const { item } = Astro.props;
---

<li class="achievement">
  <div class="achievement-photos">
    {item.photos.map((photo) => (
      <Image src={photo.src} alt={photo.alt} width={720} widths={[360, 720]} sizes="(max-width: 760px) 100vw, 320px" />
    ))}
  </div>
  <div class="achievement-copy">
    <h3>{item.title}</h3>
    <p class="muted achievement-event">{item.event}, {item.date}</p>
    <ul class="achievement-results">
      {item.results.map((result) => <li>{result}</li>)}
    </ul>
    <p class="achievement-role">Role: {item.role}</p>
    {item.summary && <p class="achievement-summary">{item.summary}</p>}
  </div>
</li>
