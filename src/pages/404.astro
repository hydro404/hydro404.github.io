---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found" noindex>
  <section class="container rail hero not-found">
    <div class="rail-body rail-body-offset">
      <h1>This page has moved on.</h1>
      <p class="hero-now">The address may be out of date. Everything I’ve built is on the homepage.</p>
      <ul class="link-row"><li><a href="/#work">See my projects</a></li><li><a href="/">Go to the homepage</a></li></ul>
    </div>
  </section>
</SiteLayout>
<style>.not-found { min-height: 60vh; }</style>
