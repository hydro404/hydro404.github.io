---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import TechBadges from '../components/TechBadges.astro';
import { highlights } from '../data/achievements';
import { education, experience, profile, projects } from '../data/portfolio';
import { toolkit } from '../data/technologies';
---
<SiteLayout title="Home">
  <noscript slot="head"><style>.project-modal:target { display: block; position: fixed; inset: 0; z-index: 50; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; border-radius: 0; overflow: auto; }</style></noscript>

  <section class="container rail hero profile-hero" aria-labelledby="profile-name">
    <img class="hero-portrait" src="/images/luis.jpg" alt="Portrait of Luis Anthony Grado" width="2432" height="2272" fetchpriority="high" />
    <div class="rail-body">
      <h1 id="profile-name">{profile.name}</h1>
      <p class="profile-role">{profile.role}</p>
      <p class="profile-summary">I turn ideas into useful software, from web and mobile applications to business systems and automation.</p>
      <div class="hero-actions">
        <a class="button" href={profile.calendly} target="_blank" rel="noopener noreferrer">Schedule a meeting <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a>
        <ul class="link-row">
          <li><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></li>
          <li><a href={profile.resume} download>Download résumé</a></li>
        </ul>
      </div>
      <p class="profile-location">Based in the Philippines</p>
    </div>
  </section>

  <section class="container rail rail-section" id="work" aria-labelledby="work-heading">
    <h2 class="rail-label" id="work-heading">Work</h2>
    <div class="rail-body project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="container rail rail-section" id="toolkit" aria-labelledby="toolkit-heading">
    <h2 class="rail-label" id="toolkit-heading">Tech stack</h2>
    <div class="rail-body">
      <ul class="row-list toolkit-list">
        {toolkit.map((group) => (
          <li>
            <h3 class="row-side">{group.title}</h3>
            <TechBadges technologies={group.items} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container rail rail-section" id="experience" aria-labelledby="experience-heading">
    <h2 class="rail-label" id="experience-heading">Experience</h2>
    <div class="rail-body">
      <ol class="row-list">
        {experience.map((item) => (
          <li>
            <p class="row-side">{item.date}</p>
            <div>
              <h3>{item.title}</h3>
              <p>{item.organization}{item.type ? ` (${item.type})` : ""}</p>
              <p class="muted row-detail">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container rail rail-section" id="education" aria-labelledby="education-heading">
    <h2 class="rail-label" id="education-heading">Education</h2>
    <div class="rail-body">
      <h3 class="plain-heading">{education.degree}</h3>
      <p>{education.honors}</p>
      <p>{education.note}</p>
      <p class="muted">{education.school}</p>
    </div>
  </section>

  <section class="container rail rail-section" id="coaching" aria-labelledby="coaching-heading">
    <h2 class="rail-label" id="coaching-heading">Coaching</h2>
    <div class="rail-body">
      <p class="rail-text coaching-intro">Alongside software work, I coach student research and robotics teams at Camalig National High School.</p>
      <ul class="row-list">
        {highlights.map((item) => (
          <li>
            <p class="row-side">{item.date}</p>
            <div>
              <h3>{item.result}</h3>
              <p>{item.detail}</p>
              <p class="muted">Role: {item.role}</p>
            </div>
          </li>
        ))}
      </ul>
      <a class="more-link" href="/achievements/">See all achievements with photos</a>
    </div>
  </section>

  {projects.map((project) => <ProjectModal project={project} />)}
</SiteLayout>
